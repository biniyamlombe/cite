ANTHROPIC_API_KEY=
AS_OF_DEFAULT=2026-10-01
PACK_ROOT=
CORS_ORIGIN=http://localhost:8080,http://localhost:5173,http://localhost:3000,http://127.0.0.1:8080,http://127.0.0.1:5173
PORT=4000
# Primary extract model (Claude Sonnet 5.5 — current best speed/intelligence)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Stronger model for empty-cache upgrades and `npm run extract -- --retry-failed`
ANTHROPIC_RETRY_MODEL=claude-opus-5-5
# Parallel docs during extract (default 4)
EXTRACT_CONCURRENCY=4
